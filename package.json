{
	"name": "elements",
	"version": "0.0.1",
	"description": "Semantic-first CSS/SCSS framework and Vue composable library, one partial per HTML element",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"exports": {
		"./browser": {
			"types": "./dist/src/browser/index.d.ts",
			"import": "./dist/src/browser/index.js",
			"default": "./dist/src/browser/index.js"
		},
		"./core": {
			"types": "./dist/src/core/index.d.ts",
			"import": "./dist/src/core/index.js",
			"default": "./dist/src/core/index.js"
		},
		"./styles": "./dist/src/styles/index.css",
		"./styles/scss": "./dist/src/styles/scss/index.scss"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite --config configs/app/vite.browser.config.ts",
		"clean": "node -e \"try{require('node:fs').rmSync('dist',{recursive:true,force:true})}catch{}\"",
		"copy": "node -e \"try{require('node:fs').cpSync(process.argv[1],process.argv[2],{force:true});console.log(`Copied: ${process.argv[1]} to ${process.argv[2]}`)}catch(e){throw e}\"",
		"tmp:txt": "node -e \"const fs=require('node:fs'),p=require('node:path');function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);if(e.isDirectory()){walk(f)}else if(!e.name.endsWith('.md')&&!e.name.endsWith('.txt')){const t=f+'.txt';if(!fs.existsSync(t)){fs.renameSync(f,t)}else{console.warn('Skipping '+f+' — target exists: '+t)}}}}try{walk('tmp')}catch(e){if(e.code!=='ENOENT')throw e}\"",
		"check": "oxlint --config .oxlintrc.json --fix . && vue-tsc --noEmit --project tsconfig.json",
		"format": "oxfmt --config .oxfmtrc.json --write src tests app",
		"test": "vitest run --config vite.config.ts --no-cache --reporter=dot",
		"test:app": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:core --project app:browser",
		"test:app:core": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:core",
		"test:app:browser": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:browser",
		"test:src": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:core --project src:browser",
		"test:src:core": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:core",
		"test:src:browser": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:browser",
		"test:src:styles": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:styles",
		"build": "npm run clean && npm run build:src && npm run build:app",
		"build:src": "npm run build:src:styles && npm run build:src:browser && npm run build:src:core",
		"build:src:styles": "vite build --config configs/src/vite.styles.config.ts",
		"build:src:browser": "vite build --config configs/src/vite.browser.config.ts && tsc -p configs/src/tsconfig.browser.json",
		"build:src:core": "vite build --config configs/src/vite.core.config.ts && tsc -p configs/src/tsconfig.core.json",
		"build:app": "npm run build:app:browser",
		"build:app:browser": "vite build --config configs/app/vite.browser.config.ts",
		"showcase": "vite --config configs/app/vite.showcase.config.ts",
		"build:showcase": "vite build --config configs/app/vite.showcase.config.ts",
		"show": "npm run build:showcase && npm run copy dist/showcase/index.html demo/showcase.html",
		"prepublishOnly": "npm run format && npm run check && npm run build && npm test"
	},
	"dependencies": {
		"@vue/reactivity": "^3.5.34"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^25.8.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vitest/browser-playwright": "^4.1.6",
		"oxfmt": "^0.49.0",
		"oxlint": "^1.64.0",
		"playwright": "^1.60.0",
		"sass": "^1.99.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^4.1.6",
		"vue": "^3.5.34",
		"vue-tsc": "^3.2.9"
	}
}
